# Copie para .env e preencha. O .env não vai para o git.
#
#   cp .env.example .env
#
# Passo a passo de como obter cada valor: docs/setup.md

# --- OpenRouter --------------------------------------------------------------
# Chave em https://openrouter.ai/keys
#
# O modelo é gratuito, mas o tier free limita ~50 requisições/dia sem crédito na
# conta, e cada mensagem consome de 2 a 4. Com US$ 10 comprados uma vez o limite
# vai para ~1000/dia, e o crédito não é consumido por modelos `:free`.
OPENROUTER_API_KEY=

# --- Telegram ----------------------------------------------------------------
# Token do @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=

# Seu ID numérico, obtido com /start no @userinfobot.
# É a trava de segurança: só estes IDs conseguem falar com o bot.
TELEGRAM_ALLOWED_USERS=

# Chat que recebe os relatórios agendados e os alertas de limite.
# Em conversa privada, é o mesmo valor do seu ID.
TELEGRAM_HOME_CHANNEL=

# --- Permissões de arquivo ---------------------------------------------------
# Deixe vazio: o `make up` preenche com `id -u` e `id -g` para que os arquivos
# em data/ continuem editáveis por você no host.
HERMES_UID=
HERMES_GID=

# --- Opcionais ---------------------------------------------------------------
# Dashboard web em http://127.0.0.1:9119
HERMES_DASHBOARD=1
DASHBOARD_PORT=9119
