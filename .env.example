# Copy to .env and fill in. The .env file is never committed.
#
#   cp .env.example .env
#
# Step-by-step instructions for each value: docs/setup.md

# --- OpenRouter --------------------------------------------------------------
# Create a key at https://openrouter.ai/keys
#
# The model itself is free, but the free tier caps you at ~50 requests/day with
# no credit on the account, and each message spends 2 to 4. Buying US$ 10 of
# credit once raises the cap to ~1000/day, and that credit is not consumed by
# `:free` models.
OPENROUTER_API_KEY=

# --- Telegram ----------------------------------------------------------------
# Token from @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=

# Your numeric id, from /start on @userinfobot.
# This is the bot's security gate: only these ids can talk to it.
TELEGRAM_ALLOWED_USERS=

# Fallback chat for anything Hermes delivers without an explicit target.
# Scheduled reports do NOT use this: `make cron-install` creates one set of jobs
# per person, each delivering to that person's own private chat. Set it to your
# own id so a stray Hermes-level notification still reaches somebody.
TELEGRAM_HOME_CHANNEL=

# --- Tally access code (OPTIONAL — prefer per-person invites) -----------------
# Everybody types a code ONCE, on their first contact with the bot. Until they
# do, Tally refuses to record or show any amount.
#
# There are two ways to hand out that code, and they work side by side:
#
#   1. RECOMMENDED — one invite per person, minted on the host:
#
#          make invite LABEL="Namorada" [HOURS=48]
#
#      Single use, expires, and only its SHA-256 is stored: the code is printed
#      once and can never be shown again. `make revoke TG_USER=<id>` then cuts
#      off one person without disturbing anybody (and deletes no data).
#
#   2. SIMPLE — one shared code, below:
#
#          openssl rand -base64 24
#
# Leaving this EMPTY is supported and is the better end state: once everybody has
# redeemed an invite, delete the value and `make restart`. Nobody is signed out
# (sessions live in the database), and no standing secret is left in the
# container's environment for the agent to print with `env`. `make up` only
# complains when nobody can get in at all — no code, no invite, nobody
# registered.
#
# Share whichever code out of band: say it in person, never in a chat. Changing
# the value here does NOT sign anyone out — whoever is in stays in. To force
# everybody to type a code again, `make logout-all`; to cut off one person,
# `make revoke TG_USER=<id>`. Neither deletes a transaction.
TALLY_ACCESS_CODE=

# --- File permissions --------------------------------------------------------
# Leave blank: `make up` fills these from `id -u` and `id -g` so that files under
# data/ stay editable by you on the host.
HERMES_UID=
HERMES_GID=

# --- Optional ----------------------------------------------------------------
# Web dashboard at http://127.0.0.1:9119. Off by default: it displays your API
# keys, so it should not be listening on a host that does not need it. `env_file`
# wins over the compose default, so this line is what actually decides.
HERMES_DASHBOARD=0
DASHBOARD_PORT=9119
